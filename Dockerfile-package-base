FROM --platform=linux/amd64 ruby:3.4.10-slim@sha256:b573616eed67613e1d380ebb777d87aa094fad7505bdbc2d1b45dca9dd9116b9

RUN apt-get update && apt-get install -y \
    curl \
    zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV HOME=/app
WORKDIR $HOME

RUN useradd --create-home --home-dir $HOME user \
    && mkdir -p $HOME \
    && chown -R user:user $HOME

RUN gem install bundler:2.5.18
RUN bundle install
COPY Rakefile README.md Gemfile Gemfile.lock VERSION $HOME/
COPY tasks $HOME/tasks
COPY packaging $HOME/packaging
RUN bundle exec rake package