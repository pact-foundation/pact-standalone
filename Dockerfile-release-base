FROM --platform=linux/amd64 ruby:3.4.12-alpine@sha256:53dd359160ceeb7963f8e9efea8a2bbbb65278276e024bb0f058261152b5610d

# Installation path
ENV HOME=/app
WORKDIR $HOME

RUN set -ex && \
  adduser -h $HOME -s /bin/false -D -S -G root ruby && \
  chmod g+w $HOME && \
  apk add --update --no-cache make gcc libc-dev git

RUN gem install bundler -v "~> 2.5"
COPY Gemfile Gemfile.lock $HOME/
RUN bundle install --no-cache
