FROM --platform=linux/amd64 ruby:3.4.11-alpine@sha256:964cc9931ae515b7b4e0822f6d88e0c5e33a92033a024b242f52a0c08dd1c4cb

# Installation path
ENV HOME=/app
WORKDIR $HOME

RUN set -ex && \
  adduser -h $HOME -s /bin/false -D -S -G root ruby && \
  chmod g+w $HOME && \
  apk add --update --no-cache make gcc libc-dev git

RUN gem install bundler -v "~> 2.5"
COPY Gemfile Gemfile.lock $HOME/
RUN bundle install --no-cache
