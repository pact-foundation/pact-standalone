FROM --platform=linux/amd64 ruby:3.4.13-alpine@sha256:9010b7942739e483ab8e359eae1190ea10af21cf7476daa41ece6f896dc8e02a

# Installation path
ENV HOME=/app
WORKDIR $HOME

RUN set -ex && \
  adduser -h $HOME -s /bin/false -D -S -G root ruby && \
  chmod g+w $HOME && \
  apk add --update --no-cache make gcc libc-dev git

RUN gem install bundler -v "~> 2.5"
COPY Gemfile Gemfile.lock $HOME/
RUN bundle install --no-cache
